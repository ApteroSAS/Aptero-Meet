{
    "compilerOptions": {
      "noImplicitAny": false,
      "outDir": "build/types",
      "module": "esnext",
      "target": "ES5",
      "allowJs": true,
      "sourceMap": true,
      "declaration": true,
      "emitDeclarationOnly": true,
      "suppressImplicitAnyIndexErrors": true,
      "lib": ["es2018", "dom"],
      "moduleResolution": "node",
      "baseUrl": "./",
      // Ensure that Babel can safely transpile files in the TypeScript project
      "isolatedModules": true,
      "jsx": "react"
    },
    "include": ["src/**/*.ts","src/**/*.tsx"],
    "exclude": ["*.js"]
}
