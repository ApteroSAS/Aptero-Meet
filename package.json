{
  "name": "aptero",
  "version": "0.0.1",
  "description": "Aptero",
  "main": "src/index.js",
  "scripts": {
    "dev:teamsfx": "echo \"execute the server on manualy on port 53000 'yarn dev:teamsfx2' \"",
    "dev:teamsfx2": "cross-env-shell \"env-cmd --silent -f ./tabs/.env.teamsfx.local yarn run start\"",
    "build:teamsfx": "cross-env-shell \"env-cmd -f ./tabs/.env.teamsfx.${TEAMS_FX_ENV} yarn run build\"",
    "build:teamsfx:dev": "cross-env TEAMS_FX_ENV=dev npm run build:teamsfx",
    "info": "npm-scripts-info",
    "start": "webpack-dev-server --mode=development",
    "start-prod": "webpack-dev-server --mode=production",
    "dev": "webpack-dev-server --mode=development",
    "build": "rimraf ./dist && tsc && webpack --mode=production",
    "prettier": "prettier --write '*.js' 'src/**/*.js'",
    "lint:js": "eslint '*.js' 'scripts/**/*.js' 'src/**/*.js'",
    "lint:html": "htmlhint 'src/**/*.html' && node scripts/indent-linter.js 'src/**/*.html'",
    "lint": "npm run lint:js && npm run lint:html",
    "test": "npm run lint && npm run test:unit && npm run build",
    "test:unit": "ava",
    "stats": "rimraf ./dist && webpack --mode=production --json",
    "spritesheet": "npm run spritesheet:system-action && npm run spritesheet:system-notice",
    "spritesheet:system-action": "spritesheet-js -f json -p src/assets/images/spritesheets/ --padding 8 --divisibleByTwo -n sprite-system-action-spritesheet --powerOfTwo src/assets/images/sprites/action/*",
    "spritesheet:system-notice": "spritesheet-js -f json -p src/assets/images/spritesheets/ --padding 8 --divisibleByTwo -n sprite-system-notice-spritesheet --powerOfTwo src/assets/images/sprites/notice/*",
    "intl-extract": "node ./src/assets/locales/intl-extract.js",
    "intl-extract-en-locale": "node ./src/assets/locales/intl-extract.js en",
    "ci:test": "cross-env NODE_ENV=development npx playwright test --config ./test/playwright.config.js",
    "ci:load:run": "cross-env npx playwright test --config ./test/playwright-load.config.js",
    "ci:debug:run:one": "cross-env CI=1 PW_PORT=53000 PWDEBUG=1 npx playwright test --config ./test/playwright-teams.config.js ./test/playwright-teams/Page.test.ts",
    "ci:debug:serve": "cross-env NODE_ENV=development PW_PORT=53000 yarn run dev",
    "ci:debug:run": "cross-env CI=true PW_PORT=53000 NODE_ENV=development PWDEBUG=1 npx playwright test --config ./test/playwright.config.js --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.js && npx http-server dist -p 53000 --ssl --cert ./certs/cert.pem --key ./certs/key.pem",
    "ci:coverage:playwright:run": "cross-env NODE_ENV=development PLAYWRIGHT_JUNIT_OUTPUT_NAME=./coverage/junit/junit.xml npx playwright test --config ./test/playwright.config.js --workers=1 --reporter=junit",
    "ci:coverage:teams:run": "cross-env NODE_ENV=development PLAYWRIGHT_JUNIT_OUTPUT_NAME=./coverage/junit/junit-teams.xml npx playwright test --config ./test/playwright-teams.config.js --workers=1 --reporter=junit",
    "ci:coverage:run": "cross-env yarn ci:coverage:playwright:run && yarn ci:coverage:teams:run",
    "ci:coverage:serve:run": "cross-env CI=true START_SERVER_AND_TEST_INSECURE=1 start-server-and-test ci:coverage:serve https://127.0.0.1:53000 ci:coverage:run",
    "ci": "cross-env yarn run clean && yarn run ci:coverage:serve:run && nyc --no-clean yarn --version",
    "clean": "rimraf .nyc_output coverage junit.xml dist"
  },
  "scripts-info": {
    "start": "Run the client against your Hubs Cloud instance, or Mozilla's developer infrastructure,\n  using application configs pulled from the server",
    "dev": "Run the client against Mozilla's developer infrastructure with all features enabled",
    "local": "Run the client against you local reticulum server",
    "login": "Log in to your Hubs Cloud instance",
    "logout": "Log out of your Hubs Cloud instance",
    "deploy": "Build and deploy the client to your Hubs Cloud instance",
    "undeploy": "Undeploy your custom client from your Hubs Cloud instance and revert it to the standard client",
    "build": "Build production-ready code and assets",
    "lint": "Check the source code for formatting and errors",
    "prettier": "Format all source code in-place",
    "test": "Check code, run tests and build the code",
    "spritesheet": "Re-build spritesheets from their source images"
  },
  "ava": {
    "files": [
      "./test/unit"
    ],
    "sources": [
      "src/**/*.js"
    ],
    "require": [
      "@babel/register",
      "esm"
    ]
